      "raw": "sting-victory",
      "bake": { "type": "audio-clip", "name": "sting-victory", "bucket": "audio", "sampleFormat": "pcm16", "mixdown": true, "embed": false, "urlBase": "/moth/files", "normalize": true, "peak": 0.98, "meta": { "kind": "stinger", "bus": "effects", "duck": true } }
    },
    {
      "id": "sting-defeat",
      "engine": "qrc-audio-v1",
      "enabled": false,
      "credits": 5,
      "consumer": "layered with SynthAudio.sting('defeat')",
