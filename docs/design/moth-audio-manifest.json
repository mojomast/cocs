      "params": { "chunk_seconds": 1, "length": 12, "crossfade": 80, "loop": true, "quality": "moderate", "seed": 42, "variation": 0.8 },
      "raw": "bed-combat",
      "bake": {
        "type": "audio-clip",
        "name": "bed-combat",
        "bucket": "audio",
        "sampleFormat": "pcm16",
        "mixdown": true,
        "embed": false,
        "urlBase": "/moth/files",
        "loopStart": 0.5,
        "loopEnd": 11.5,
        "normalize": true,
        "peak": 0.95,
        "meta": { "kind": "bed", "group": "combat", "bus": "ambience" }
      }
    },
