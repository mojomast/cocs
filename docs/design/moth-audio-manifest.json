      "raw": "loop-ash",
      "bake": { "type": "audio-clip", "name": "weather-ash", "bucket": "audio", "sampleFormat": "pcm16", "mixdown": true, "embed": false, "urlBase": "/moth/files", "loopStart": 0.5, "loopEnd": 9.5, "meta": { "kind": "weather", "mood": "hot", "bus": "ambience" } }
    },
