    },
    {
      "id": "loop-rain",
      "engine": "qrc-audio-v1",
      "enabled": false,
      "credits": 5,
      "consumer": "rain/storm weather loop -> ambienceBus when weatherPreset.audio is 'storm'",
      "input": { "audio": "sources/bed-seed.wav" },
      "params": { "chunk_seconds": 1, "length": 10, "crossfade": 100, "loop": true, "quality": "moderate", "seed": 61, "variation": 0.4 },
