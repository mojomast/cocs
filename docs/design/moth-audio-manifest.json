{
  "version": 3,
  "note": "PROPOSED Moth audio job list — merge into assets/moth/manifest.json. First-batch jobs are enabled:true (20 credits). Deferred jobs are enabled:false and carry a `consumer` note. Requires scripts/moth-bake.mjs to grow an audio-clip baker, an echo-map baker and a makeSourceAudio source generator (see docs/design/MOTH-AUDIO-PLAN.md §5). `sources/bed-seed.wav` is generated locally (free, deterministic, original) by the new source-audio generator before running. `input` is the game-manifest key (mothbake uses `inputs`).",
  "engineCredits": {
    "retrocausal-echo-v1": 2,
    "otoc-echo-v1": 1,
    "qrc-audio-v1": 5,
    "qrc-midi-v1": 5,
    "blur-midi-v1": 1
  },
  "batches": {
    "first": {
      "credits": 20,
      "jobs": [
        "ir-openair",
        "ir-tunnel",
        "ir-void",
        "echo-arena",
        "echo-tunnel",
        "motif-victory",
        "motif-defeat",
        "bed-ritual",
        "bed-combat"
      ]
    },
    "minimumPipelineProof": {
      "credits": 8,
      "jobs": ["ir-openair", "echo-arena", "bed-ritual"]
    },
    "fullPassEstimate": {
      "credits": 160,
      "note": "Stage A (spaces+motifs) ~26 cr, Stage B (beds+weather) ~70 cr, Stage C (stingers+cues+voices) ~64 cr."
    }
  },
  "jobs": [
    {
      "id": "ir-openair",
      "engine": "retrocausal-echo-v1",
      "enabled": true,
      "credits": 2,
      "consumer": "per-map reverb space (open/outdoor arenas) via SynthAudio.setReverbUrl",
      "params": {
        "emit": "audio",
        "ir_seconds": 1.5,
        "sr": 22050,
        "output_format": "pcm_16",
        "lattice": "square",
        "width": 6,
        "height": 3,
        "depth": 4,
        "theta_zz": 0.7853981634,
        "theta_x": 0.85,
        "theta_z": 0.2,
        "kick": "Z",
        "disorder": 0,
        "seed": 101,
        "decay": 0.6,
        "feedback": 0.25,
        "feedback_source": "kick",
        "diffusion_ms": 60,
        "min_level": 0.05,
        "max_regen": 12,
        "negative_mode": "phase",
        "stereo_width": 1,
        "mix": 1,
        "ref_floor": 0.02,
        "include_tap_map": true
      },
      "raw": "ir-openair",
      "bake": { "type": "ir", "name": "openair", "bucket": "irs" }
    },
    {
      "id": "ir-tunnel",
      "engine": "retrocausal-echo-v1",
      "enabled": true,
      "credits": 2,
      "consumer": "long corridor reverb for tunnel/substation maps via SynthAudio.setReverbUrl",
      "params": {
        "emit": "audio",
        "ir_seconds": 3.5,
        "sr": 22050,
        "output_format": "pcm_16",
        "lattice": "chain",
        "n_sites": 8,
        "depth": 12,
        "master_ms": 900,
        "theta_zz": 1.0995574287564276,
        "theta_x": 0.9424777960769379,
        "theta_z": 0.15,
        "kick": "Z",
        "disorder": 0.2,
        "seed": 202,
        "decay": 0.9,
        "feedback": 0.6,
        "feedback_source": "all",
        "min_level": 0.05,
        "max_regen": 32,
        "negative_mode": "reverse",
        "stereo_width": 1,
        "mix": 1,
        "ref_floor": 0.02,
        "include_tap_map": true
      },
      "raw": "ir-tunnel",
      "bake": { "type": "ir", "name": "tunnel", "bucket": "irs" }
    },
    {
      "id": "ir-void",
      "engine": "retrocausal-echo-v1",
      "enabled": true,
      "credits": 2,
      "consumer": "huge, diffuse reverb for the Void/neon maps; also a room-tone source",
      "params": {
        "emit": "audio",
        "ir_seconds": 5,
        "sr": 22050,
        "output_format": "pcm_16",
        "lattice": "square",
        "width": 4,
        "height": 4,
        "depth": 16,
        "theta_zz": 0.7853981634,
        "theta_x": 0.6,
        "theta_z": 0.4,
        "kick": "Z",
        "disorder": 0.35,
        "seed": 303,
        "decay": 0.95,
        "feedback": 0.35,
        "feedback_source": "all",
        "diffusion_ms": 400,
        "min_level": 0.04,
        "max_regen": 48,
        "negative_mode": "phase",
        "stereo_width": 1.2,
        "mix": 1,
        "ref_floor": 0.02,
        "include_tap_map": true
      },
      "raw": "ir-void",
      "bake": { "type": "ir", "name": "void", "bucket": "irs" }
    },
    {
      "id": "echo-arena",
      "engine": "otoc-echo-v1",
      "enabled": true,
      "credits": 1,
      "consumer": "tap map driving SynthAudio.space delay/feedback/gain for arena maps",
      "params": {
        "lattice": "square",
        "width": 5,
        "height": 5,
        "depth": 8,
        "kick": "Z",
        "theta_zz": 0.7853981634,
        "theta_x": 0.6,
        "theta_z": 0.4,
        "disorder": 0.15,
        "seed": 12345,
        "exact": true,
        "shots": 4096,
        "include_taps": true,
        "include_z": false,
        "min_tap_level": 0.03
      },
      "raw": "echo-arena",
      "bake": { "type": "echo-map", "name": "arena", "bucket": "spaces", "maxTaps": 128 }
    },
    {
      "id": "echo-tunnel",
      "engine": "otoc-echo-v1",
      "enabled": true,
      "credits": 1,
      "consumer": "long, sparse tap map for corridor maps (drive-by gunfire tails)",
      "params": {
        "lattice": "chain",
        "n_sites": 8,
        "depth": 12,
        "kick": "Z",
        "theta_zz": 1.0995574287564276,
        "theta_x": 0.9424777960769379,
        "theta_z": 0.25,
        "disorder": 0.25,
        "seed": 777,
        "exact": true,
        "shots": 4096,
        "include_taps": true,
        "include_z": false,
        "min_tap_level": 0.04
      },
      "raw": "echo-tunnel",
      "bake": { "type": "echo-map", "name": "tunnel", "bucket": "spaces", "maxTaps": 96 }
    },
    {
      "id": "motif-victory",
      "engine": "blur-midi-v1",
      "enabled": true,
      "credits": 1,
      "consumer": "results/victory motif via MusicEngine.setMotif",
      "input": { "midi": "sources/motif.mid" },
      "params": { "strength": 0.25, "reach": 0.15, "qubits": 20, "threshold": 0.08, "margin": 0.15 },
      "raw": "motif-victory",
      "bake": { "type": "motif", "name": "moth-victory", "bucket": "motifs" }
    },
    {
      "id": "motif-defeat",
      "engine": "blur-midi-v1",
      "enabled": true,
      "credits": 1,
      "consumer": "defeat motif via MusicEngine.setMotif",
      "input": { "midi": "sources/motif.mid" },
      "params": { "strength": 0.5, "reach": 0.35, "qubits": 20, "threshold": 0.1, "margin": 0.15 },
      "raw": "motif-defeat",
      "bake": { "type": "motif", "name": "moth-defeat", "bucket": "motifs" }
    },
    {
      "id": "bed-ritual",
      "engine": "qrc-audio-v1",
      "enabled": true,
      "credits": 5,
      "consumer": "menu/explore ambient bed -> ambienceBus, crossfaded by scene/intensity",
      "input": { "audio": "sources/bed-seed.wav" },
      "params": { "chunk_seconds": 1, "length": 12, "crossfade": 120, "loop": true, "quality": "moderate", "seed": 11, "variation": 0.6 },
      "raw": "bed-ritual",
      "bake": {
        "type": "audio-clip",
        "name": "bed-ritual",
        "bucket": "audio",
        "sampleFormat": "pcm16",
        "mixdown": true,
        "embed": false,
        "urlBase": "/moth/files",
        "loopStart": 0.5,
        "loopEnd": 11.5,
        "normalize": true,
        "peak": 0.9,
        "meta": { "kind": "bed", "group": "ritual", "bus": "ambience" }
      }
    },
    {
      "id": "bed-combat",
      "engine": "qrc-audio-v1",
      "enabled": true,
      "credits": 5,
      "consumer": "combat ambient bed -> ambienceBus at high intensity",
