{
  "name": "token-arena",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "server": "node server/game-server.mjs",
    "demo": "node server/demo-client.mjs",
    "build": "bash scripts/build-verified.sh",
    "deploy": "bash scripts/deploy.sh",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:graphics-lab": "node scripts/verify-graphics-lab.mjs",
    "test:browser:install": "playwright install chromium",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:game && npm run test:server && npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:game": "node --test --test-timeout=600000 game/*.test.mjs",
    "test:game:slow": "COCS_SLOW_TESTS=1 node --test --test-timeout=1800000 game/*.test.mjs",
    "test:archive": "node --test --test-timeout=120000 game/archive/*.test.mjs",
    "test:all": "npm run test:game && npm run test:archive",
    "test:server": "node --test --test-timeout=120000 server/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.55.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
